# Environment for roc-recording systemd service
# Installed to: /etc/roc-recording.env

PUBLIC_URL=http://10.199.28.249:8080
# Public URL for commentator invite links (frontend origin, HTTPS). Defaults to PUBLIC_URL.
COMMENTATOR_PUBLIC_URL=https://recording.nepsweden.tech
# Hostname clients use in published SRT listener URLs (defaults to host from PUBLIC_URL)
PUBLIC_SRT_HOST=10.199.28.249
API_KEY=change-me
ALLOWED_ORIGINS=*
