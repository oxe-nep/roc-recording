{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.nep.commentator",
  "Name": "NEP Commentator",
  "Version": "0.5.0.1",
  "Author": "NEP Sweden",
  "Description": "PTT intercom and volume control for NEP remote commentator sessions.",
  "Icon": "imgs/plugin",
  "Category": "NEP Commentator",
  "CategoryIcon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "UUID": "com.nep.commentator.ptt",
      "Name": "Intercom PTT",
      "Tooltip": "Hold for intercom push-to-talk",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "property-inspector/ptt.html",
      "States": [
        {
          "Image": "imgs/action",
          "TitleAlignment": "bottom",
          "FontSize": 12
        },
        {
          "Image": "imgs/action-active",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "com.nep.commentator.volume",
      "Name": "Volume",
      "Tooltip": "Tap to adjust PGM or intercom volume",
      "Icon": "imgs/volume",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "property-inspector/volume.html",
      "States": [
        {
          "Image": "imgs/volume",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    },
    {
      "UUID": "com.nep.commentator.connect",
      "Name": "Connect",
      "Tooltip": "Link Stream Deck to the commentator session using a pairing code",
      "Icon": "imgs/plugin",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "property-inspector/connect.html",
      "States": [
        {
          "Image": "imgs/plugin",
          "TitleAlignment": "bottom",
          "FontSize": 11
        }
      ]
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/commentator",
      "DeviceType": 0,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": false,
      "Readonly": false
    },
    {
      "Name": "profiles/commentator-mini",
      "DeviceType": 1,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": false,
      "Readonly": false
    },
    {
      "Name": "profiles/commentator-xl",
      "DeviceType": 2,
      "AutoInstall": true,
      "DontAutoSwitchWhenInstalled": false,
      "Readonly": false
    }
  ]
}